{
  "name": "ww-subtitle-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for parsing, manipulating, and formatting subtitle files",
  "author": "Linn Latt",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/core/index.js",
      "types": "./dist/src/core/index.d.ts"
    },
    "./node": {
      "import": "./dist/src/node/index.js",
      "types": "./dist/src/node/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": ["./dist/src/core/index.d.ts"],
      "node": ["./dist/src/node/index.d.ts"]
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx src/core/tests/srt-parser.test.ts && tsx src/core/tests/vtt-parser.test.ts && tsx src/core/tests/txt-parser.test.ts && tsx src/core/tests/subtitle-converter.test.ts && tsx src/node/tests/response-mapper.test.ts",
    "test:srt": "tsx src/core/tests/srt-parser.test.ts",
    "test:vtt": "tsx src/core/tests/vtt-parser.test.ts",
    "test:txt": "tsx src/core/tests/txt-parser.test.ts",
    "test:converter": "tsx src/core/tests/subtitle-converter.test.ts",
    "test:mapper": "tsx src/node/tests/response-mapper.test.ts"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
