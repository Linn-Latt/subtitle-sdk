{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",

    "module": "nodenext",
    "target": "esnext",

    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    "skipLibCheck": true
  },

  "include": ["src", "tests"]
}